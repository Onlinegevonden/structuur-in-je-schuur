<section class="section">
  <div class="container-narrow">
    <div class="cta-box">
      <div class="cta-box__accent"></div>
      <h2 class="cta-box__title">{{ section.settings.title }}</h2>
      <p class="cta-box__description">{{ section.settings.description }}</p>
      <div class="cta-box__buttons">
        {%- if section.settings.button1_text != blank -%}
        <a href="{{ section.settings.button1_url }}" class="btn btn-brand btn-lg">
          {{ section.settings.button1_text }}
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
        <a href="{{ section.settings.button2_url }}" class="btn btn-ghost btn-lg">{{ section.settings.button2_text }}</a>
        {%- endif -%}
      </div>
      {%- if section.settings.trust_text != blank -%}
      <p class="cta-box__trust">{{ section.settings.trust_text }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Call-to-Action",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Klaar om je schuur te transformeren?" },
    { "type": "textarea", "id": "description", "label": "Beschrijving", "default": "Begin dit weekend nog. Download het bouwplan en maak een einde aan de chaos." },
    { "type": "text", "id": "button1_text", "label": "Knop 1 tekst", "default": "Download voor €19" },
    { "type": "url", "id": "button1_url", "label": "Knop 1 URL", "default": "/collections/all" },
    { "type": "text", "id": "button2_text", "label": "Knop 2 tekst", "default": "Bekijk voorbeelden" },
    { "type": "url", "id": "button2_url", "label": "Knop 2 URL" },
    { "type": "text", "id": "trust_text", "label": "Trust tekst", "default": "✓ 500+ tevreden klanten • ✓ Direct downloaden • ✓ 100% garantie" }
  ],
  "presets": [{ "name": "Call-to-Action" }]
}
{% endschema %}
