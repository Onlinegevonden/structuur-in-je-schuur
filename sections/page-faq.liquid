<style>
.page-faq{background-color:var(--background)}.page-hero{padding:4rem 0;border-bottom:1px solid var(--border);background:linear-gradient(to bottom,rgba(255,249,230,.3),var(--background))}@media(min-width:1024px){.page-hero{padding:6rem 0}}.page-hero__back{display:inline-flex;align-items:center;gap:.5rem;margin-bottom:1.5rem;font-size:.875rem;color:var(--muted-foreground);transition:color .2s}.page-hero__back:hover{color:var(--foreground)}.page-hero__back-icon{width:1rem;height:1rem}.page-hero__title{font-size:1.875rem;font-weight:700}@media(min-width:768px){.page-hero__title{font-size:2.25rem}}@media(min-width:1024px){.page-hero__title{font-size:3rem}}.page-hero__subtitle{margin-top:1rem;max-width:42rem;font-size:1.125rem;color:var(--muted-foreground);line-height:1.7}.faq-section{padding:4rem 0}@media(min-width:1024px){.faq-section{padding:6rem 0}}.faq-container{max-width:48rem;margin:0 auto}.faq-category{margin-bottom:3rem}.faq-category:last-child{margin-bottom:0}.faq-category__title{font-size:1.25rem;font-weight:700;margin-bottom:1.5rem;color:var(--foreground)}.faq-list{border-top:1px solid var(--border)}.faq-item{border-bottom:1px solid var(--border)}.faq-item__button{display:flex;align-items:center;justify-content:space-between;width:100%;padding:1.25rem 0;text-align:left;font-family:'Sora',sans-serif;font-size:1rem;font-weight:600;color:var(--foreground);background:none;border:none;cursor:pointer;transition:color .2s}.faq-item__button:hover{color:var(--brand)}.faq-item__icon{width:1.25rem;height:1.25rem;flex-shrink:0;margin-left:1rem;color:var(--muted-foreground);transition:transform .3s}.faq-item.is-open .faq-item__icon{transform:rotate(180deg)}.faq-item__content{display:none;padding-bottom:1.25rem;color:var(--muted-foreground);line-height:1.7}.faq-item.is-open .faq-item__content{display:block}.faq-cta{padding:4rem 0;border-top:1px solid var(--border);background-color:rgba(255,249,230,.3);text-align:center}.faq-cta__title{font-size:1.5rem;font-weight:700;margin-bottom:1rem}.faq-cta__text{color:var(--muted-foreground);margin-bottom:1.5rem}.faq-cta__btn{display:inline-flex;align-items:center;justify-content:center;height:2.75rem;padding:0 1.5rem;font-weight:500;color:var(--brand-foreground);background-color:var(--brand);border-radius:.5rem;transition:background-color .2s}.faq-cta__btn:hover{background-color:#E6B800}
</style>

<div class="page-faq">
  <section class="page-hero">
    <div class="container">
      <a href="/" class="page-hero__back">
        <svg class="page-hero__back-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
        Terug naar home
      </a>
      <h1 class="page-hero__title font-sora">{{ section.settings.title }}</h1>
      <p class="page-hero__subtitle">{{ section.settings.subtitle }}</p>
    </div>
  </section>

  <section class="faq-section">
    <div class="container">
      <div class="faq-container">
        {% assign current_category = '' %}
        {% for block in section.blocks %}
          {% if block.type == 'faq' %}
            {% if block.settings.category != current_category %}
              {% if current_category != '' %}
                </div></div>
              {% endif %}
              {% assign current_category = block.settings.category %}
              <div class="faq-category">
                <h2 class="faq-category__title font-sora">{{ current_category }}</h2>
                <div class="faq-list">
            {% endif %}
            <div class="faq-item" data-faq-item {{ block.shopify_attributes }}>
              <button class="faq-item__button" type="button">
                <span>{{ block.settings.question }}</span>
                <svg class="faq-item__icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
              </button>
              <div class="faq-item__content">{{ block.settings.answer }}</div>
            </div>
          {% endif %}
        {% endfor %}
        {% if current_category != '' %}
          </div></div>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="faq-cta">
    <div class="container">
      <h2 class="faq-cta__title font-sora">{{ section.settings.cta_title }}</h2>
      <p class="faq-cta__text">{{ section.settings.cta_text }}</p>
      <a href="{{ section.settings.cta_link }}" class="faq-cta__btn">{{ section.settings.cta_button }}</a>
    </div>
  </section>
</div>

<script>
document.addEventListener('DOMContentLoaded',function(){document.querySelectorAll('[data-faq-item]').forEach(function(item){var btn=item.querySelector('.faq-item__button');if(btn){btn.addEventListener('click',function(){var isOpen=item.classList.contains('is-open');document.querySelectorAll('[data-faq-item]').forEach(function(i){i.classList.remove('is-open')});if(!isOpen){item.classList.add('is-open')}})}})});
</script>

{% schema %}
{
  "name": "FAQ pagina",
  "settings": [
    {"type": "text", "id": "title", "label": "Titel", "default": "Veelgestelde vragen"},
    {"type": "textarea", "id": "subtitle", "label": "Ondertitel", "default": "Alles wat je wilt weten over onze bouwplannen. Staat je vraag er niet bij? Neem gerust contact met ons op."},
    {"type": "header", "content": "CTA"},
    {"type": "text", "id": "cta_title", "label": "CTA titel", "default": "Vraag niet beantwoord?"},
    {"type": "text", "id": "cta_text", "label": "CTA tekst", "default": "Stuur ons een bericht en we helpen je graag verder."},
    {"type": "text", "id": "cta_button", "label": "CTA knop", "default": "Neem contact op"},
    {"type": "url", "id": "cta_link", "label": "CTA link", "default": "/pages/contact"}
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {"type": "text", "id": "category", "label": "Categorie", "default": "Over het bouwplan"},
        {"type": "text", "id": "question", "label": "Vraag", "default": "Welk gereedschap heb ik nodig?"},
        {"type": "textarea", "id": "answer", "label": "Antwoord", "default": "Basis gereedschap is voldoende: een cirkelzaag of decoupeerzaag, boormachine, meetlint, winkelhaak en schroevendraaier."}
      ]
    }
  ],
  "presets": [{
    "name": "FAQ pagina",
    "blocks": [
      {"type": "faq", "settings": {"category": "Over het bouwplan", "question": "Welk gereedschap heb ik nodig?", "answer": "Basis gereedschap is voldoende: een cirkelzaag of decoupeerzaag, boormachine, meetlint, winkelhaak en schroevendraaier. Geen professionele werkplaats nodig."}},
      {"type": "faq", "settings": {"category": "Over het bouwplan", "question": "Hoeveel kost het materiaal?", "answer": "Gemiddeld €80-120 aan materiaal bij de bouwmarkt, afhankelijk van de gekozen configuratie. Veel goedkoper dan kant-en-klare alternatieven."}},
      {"type": "faq", "settings": {"category": "Over het bouwplan", "question": "Hoelang duurt het bouwen?", "answer": "Met het complete bouwplan kun je de krattenkast in één weekend bouwen. Gemiddeld 4-6 uur voor beginners, 2-3 uur voor ervaren klussers."}},
      {"type": "faq", "settings": {"category": "Afmetingen & Aanpassingen", "question": "Past de kast in elke schuur?", "answer": "De standaard maten zijn 60 × 40 × 180 cm, maar het bouwplan bevat instructies om de afmetingen aan te passen aan jouw ruimte."}},
      {"type": "faq", "settings": {"category": "Afmetingen & Aanpassingen", "question": "Kan ik andere bakken gebruiken dan IKEA Samla?", "answer": "De standaardmaten zijn geoptimaliseerd voor IKEA Samla 45L bakken, maar het plan bevat ook instructies om aan te passen voor andere bakformaten."}},
      {"type": "faq", "settings": {"category": "Afmetingen & Aanpassingen", "question": "Kan ik de kast groter of kleiner maken?", "answer": "Absoluut! Het bouwplan bevat een calculator waarmee je eenvoudig alle maten kunt aanpassen. Perfect voor ongebruikelijke ruimtes."}},
      {"type": "faq", "settings": {"category": "Bestelling & Levering", "question": "Hoe ontvang ik het bouwplan?", "answer": "Direct na betaling ontvang je een e-mail met een downloadlink. Het bouwplan is een PDF die je kunt printen of op je tablet bekijken."}},
      {"type": "faq", "settings": {"category": "Bestelling & Levering", "question": "Kan ik het bouwplan meerdere keren downloaden?", "answer": "Ja, je hebt levenslange toegang tot het bouwplan. Je kunt het zo vaak downloaden als je wilt."}},
      {"type": "faq", "settings": {"category": "Bestelling & Levering", "question": "Wat als ik niet tevreden ben?", "answer": "100% geld-terug-garantie. Stuur binnen 14 dagen een mailtje en je krijgt je geld terug. Geen vragen, geen gedoe."}},
      {"type": "faq", "settings": {"category": "Support", "question": "Krijg ik support als ik vastloop?", "answer": "Ja! Bij elke aankoop krijg je toegang tot e-mail support. Stuur je vraag (inclusief foto's) en je krijgt binnen 24 uur antwoord."}},
      {"type": "faq", "settings": {"category": "Support", "question": "Is er een community van bouwers?", "answer": "Ja! Na aankoop krijg je toegang tot onze besloten Facebook-groep waar je vragen kunt stellen en je resultaten kunt delen."}},
      {"type": "faq", "settings": {"category": "Support", "question": "Worden de bouwplannen ge-update?", "answer": "Ja, we verbeteren onze bouwplannen continu op basis van feedback. Als je het plan hebt gekocht, krijg je alle updates gratis."}}
    ]
  }]
}
{% endschema %}
