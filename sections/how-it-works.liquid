<section class="section" id="hoe-werkt-het">
  <div class="container">
    <div class="section__header">
      {%- if section.settings.badge != blank -%}
      <span class="badge">{{ section.settings.badge }}</span>
      {%- endif -%}
      <h2 class="section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
      <p class="section__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="steps-grid">
      {%- for block in section.blocks -%}
      <div class="step" {{ block.shopify_attributes }}>
        <div class="step__icon">
          {%- case block.settings.icon -%}
            {%- when 'shopping-bag' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
            {%- when 'download' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
            {%- when 'hammer' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 12-8.5 8.5c-.83.83-2.17.83-3 0 0 0 0 0 0 0a2.12 2.12 0 0 1 0-3L12 9"/><path d="M17.64 15 22 10.64"/><path d="m20.91 11.7-1.25-1.25c-.6-.6-.93-1.4-.93-2.25v-.86L16.01 4.6a5.56 5.56 0 0 0-3.94-1.64H9l.92.82A6.18 6.18 0 0 1 12 8.4v1.56l2 2h2.47l2.26 1.91"/></svg>
            {%- when 'party-popper' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5.8 11.3 2 22l10.7-3.79"/><path d="M4 3h.01"/><path d="M22 8h.01"/><path d="M15 2h.01"/><path d="M22 20h.01"/><path d="m22 2-2.24.75a2.9 2.9 0 0 0-1.96 3.12v0c.1.86-.57 1.63-1.45 1.63h-.38c-.86 0-1.6.6-1.76 1.44L14 10"/><path d="m22 13-.82-.33c-.86-.34-1.82.2-1.98 1.11v0c-.11.7-.72 1.22-1.43 1.22H17"/><path d="m11 2 .33.82c.34.86-.2 1.82-1.11 1.98v0C9.52 4.9 9 5.52 9 6.23V7"/><path d="M11 13c1.93 1.93 2.83 4.17 2 5-.83.83-3.07-.07-5-2-1.93-1.93-2.83-4.17-2-5 .83-.83 3.07.07 5 2Z"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="step__title">{{ block.settings.title }}</h3>
        <p class="step__description">{{ block.settings.description }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hoe werkt het",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Zo simpel is het"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Hoe werkt het?"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitel",
      "default": "Van aankoop tot opgeruimde schuur in vier eenvoudige stappen."
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Stap",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "shopping-bag", "label": "Winkeltas" },
            { "value": "download", "label": "Download" },
            { "value": "hammer", "label": "Hamer" },
            { "value": "party-popper", "label": "Feest" }
          ],
          "default": "shopping-bag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Stap"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Beschrijving",
          "default": "Beschrijving van deze stap."
        }
      ]
    }
  ],
  "presets": [{
    "name": "Hoe werkt het",
    "blocks": [
      { "type": "step", "settings": { "icon": "shopping-bag", "title": "1. Kies je bouwplan", "description": "Selecteer het bouwplan dat past bij jouw situatie en wensen." } },
      { "type": "step", "settings": { "icon": "download", "title": "2. Direct downloaden", "description": "Na betaling ontvang je direct je PDF met alle instructies." } },
      { "type": "step", "settings": { "icon": "hammer", "title": "3. Bouw het zelf", "description": "Volg de stap-voor-stap instructies met onze duidelijke handleiding." } },
      { "type": "step", "settings": { "icon": "party-popper", "title": "4. Geniet van je resultaat", "description": "Een opgeruimde schuur binnen één weekend - gegarandeerd!" } }
    ]
  }]
}
{% endschema %}
