<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <div class="footer__brand">
        <a href="/" class="footer__logo">
          <div class="header__logo-icon">{{ section.settings.logo_letter }}</div>
          <span class="header__logo-text">{{ section.settings.logo_text }}</span>
        </a>
        <p class="footer__description">{{ section.settings.description }}</p>
        <div class="footer__social">
          {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" title="E-mail">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.instagram != blank -%}
          <a href="{{ section.settings.instagram }}" target="_blank" rel="noopener" title="Instagram">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
          </a>
          {%- endif -%}
        </div>
      </div>

      {%- for block in section.blocks -%}
        {%- if block.type == 'menu_column' -%}
        <div class="footer__nav" {{ block.shopify_attributes }}>
          <h3 class="footer__nav-title">{{ block.settings.title }}</h3>
          {%- if block.settings.menu != blank -%}
          <ul>
            {%- for link in linklists[block.settings.menu].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
          {%- endif -%}
        </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__copyright">{{ section.settings.copyright }}</p>
      <div class="footer__legal">
        {%- if section.settings.privacy_url != blank -%}
        <a href="{{ section.settings.privacy_url }}">{{ section.settings.privacy_text }}</a>
        {%- endif -%}
        {%- if section.settings.terms_url != blank -%}
        <a href="{{ section.settings.terms_url }}">{{ section.settings.terms_text }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "text",
      "id": "logo_letter",
      "label": "Logo letter",
      "default": "S"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo tekst",
      "default": "Structuur in je Schuur"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschrijving",
      "default": "Van chaos naar controle in één weekend. Praktische bouwplannen voor Nederlandse doe-het-zelvers die hun schuur of garage willen organiseren."
    },
    {
      "type": "header",
      "content": "Social media"
    },
    {
      "type": "text",
      "id": "email",
      "label": "E-mailadres",
      "default": "info@structuurinjeschuur.nl"
    },
    {
      "type": "url",
      "id": "instagram",
      "label": "Instagram URL"
    },
    {
      "type": "header",
      "content": "Juridisch"
    },
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright",
      "default": "© 2026 Structuur in je Schuur. Alle rechten voorbehouden."
    },
    {
      "type": "text",
      "id": "privacy_text",
      "label": "Privacy tekst",
      "default": "Privacybeleid"
    },
    {
      "type": "url",
      "id": "privacy_url",
      "label": "Privacy URL"
    },
    {
      "type": "text",
      "id": "terms_text",
      "label": "Voorwaarden tekst",
      "default": "Algemene voorwaarden"
    },
    {
      "type": "url",
      "id": "terms_url",
      "label": "Voorwaarden URL"
    }
  ],
  "blocks": [
    {
      "type": "menu_column",
      "name": "Menu kolom",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Titel",
          "default": "Menu"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [{
    "name": "Footer",
    "blocks": [
      { "type": "menu_column", "settings": { "title": "Bouwplannen" } },
      { "type": "menu_column", "settings": { "title": "Ondersteuning" } }
    ]
  }]
}
{% endschema %}
