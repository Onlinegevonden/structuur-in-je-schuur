<section class="hero">
  <div class="hero__gradient"></div>
  <div class="container">
    <div class="hero__content">
      <div class="hero__text">
        {%- if section.settings.badge_text != blank -%}
        <div class="badge hero__badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
          <span>{{ section.settings.badge_text }}</span>
        </div>
        {%- endif -%}

        <h1 class="hero__title">
          {{ section.settings.title_line1 }} <span class="hero__highlight">{{ section.settings.title_highlight }}</span>
        </h1>

        <p class="hero__description">{{ section.settings.description }}</p>

        <div class="hero__features">
          {%- for block in section.blocks -%}
            {%- if block.type == 'feature' -%}
            <div class="hero__feature" {{ block.shopify_attributes }}>
              {%- if block.settings.icon == 'clock' -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              {%- elsif block.settings.icon == 'download' -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              {%- else -%}
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              {%- endif -%}
              <span>{{ block.settings.text }}</span>
            </div>
            {%- endif -%}
          {%- endfor -%}
        </div>

        <div class="hero__cta">
          {%- if section.settings.button1_text != blank -%}
          <a href="{{ section.settings.button1_url }}" class="btn btn-brand btn-xl">
            {{ section.settings.button1_text }}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          {%- endif -%}
          {%- if section.settings.button2_text != blank -%}
          <a href="{{ section.settings.button2_url }}" class="btn btn-outline btn-xl">{{ section.settings.button2_text }}</a>
          {%- endif -%}
        </div>
      </div>

      <div class="hero__image-wrapper">
        <div class="hero__image-bg">
          {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image_alt }}" class="hero__image" width="800" height="800" loading="eager">
          {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'hero__image' }}
          {%- endif -%}
        </div>
        {%- if section.settings.show_price -%}
        <div class="hero__price-tag">
          <p class="hero__price-label">{{ section.settings.price_label }}</p>
          <p class="hero__price-value">{{ section.settings.price_value }}</p>
        </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge tekst",
      "default": "Digitale bouwplannen"
    },
    {
      "type": "text",
      "id": "title_line1",
      "label": "Titel regel 1",
      "default": "Van chaos naar controle"
    },
    {
      "type": "text",
      "id": "title_highlight",
      "label": "Titel highlight",
      "default": "in één weekend"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Beschrijving",
      "default": "Praktische bouwplannen voor je schuur of garage. Speciaal ontworpen voor Nederlandse bouwmarkten en IKEA opbergboxen."
    },
    {
      "type": "header",
      "content": "Knoppen"
    },
    {
      "type": "text",
      "id": "button1_text",
      "label": "Knop 1 tekst",
      "default": "Bekijk bouwplannen"
    },
    {
      "type": "url",
      "id": "button1_url",
      "label": "Knop 1 URL",
      "default": "/collections/all"
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Knop 2 tekst",
      "default": "Hoe werkt het?"
    },
    {
      "type": "url",
      "id": "button2_url",
      "label": "Knop 2 URL"
    },
    {
      "type": "header",
      "content": "Afbeelding"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero afbeelding"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Alt tekst",
      "default": "Krattenkast bouwplan - houten opbergrek met IKEA Samla boxen"
    },
    {
      "type": "header",
      "content": "Prijs tag"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Toon prijs tag",
      "default": true
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Prijs label",
      "default": "Vanaf"
    },
    {
      "type": "text",
      "id": "price_value",
      "label": "Prijs",
      "default": "€19"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icoon",
          "options": [
            { "value": "clock", "label": "Klok" },
            { "value": "download", "label": "Download" },
            { "value": "check", "label": "Vinkje" }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Tekst",
          "default": "Feature"
        }
      ]
    }
  ],
  "presets": [{
    "name": "Hero",
    "blocks": [
      { "type": "feature", "settings": { "icon": "clock", "text": "Klaar in 1 weekend" } },
      { "type": "feature", "settings": { "icon": "download", "text": "Direct downloaden" } },
      { "type": "feature", "settings": { "icon": "check", "text": "Beginner-vriendelijk" } }
    ]
  }]
}
{% endschema %}
