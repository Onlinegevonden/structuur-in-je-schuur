<section class="page-header">
  <div class="container">
    <a href="/" class="breadcrumb" style="margin-bottom: 1.5rem; display: inline-flex;">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Terug naar home</span>
    </a>
    <h1 class="page-header__title">{{ page.title }}</h1>
    {%- if section.settings.description != blank -%}
    <p class="page-header__description">{{ section.settings.description }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Pagina header",
  "settings": [
    { "type": "textarea", "id": "description", "label": "Beschrijving" }
  ],
  "presets": [{ "name": "Pagina header" }]
}
{% endschema %}
