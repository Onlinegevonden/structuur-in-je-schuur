<section class="section section--muted section--border">
  <div class="container">
    <div class="section__header">
      <h2 class="section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
      <p class="section__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="features-grid">
      {%- for block in section.blocks -%}
      <div class="feature-card" {{ block.shopify_attributes }}>
        <div class="feature-card__icon">
          {%- case block.settings.icon -%}
            {%- when 'file-text' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/><line x1="16" x2="8" y1="13" y2="13"/><line x1="16" x2="8" y1="17" y2="17"/><line x1="10" x2="8" y1="9" y2="9"/></svg>
            {%- when 'package' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
            {%- when 'ruler' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2"/><path d="m11.5 9.5 2-2"/><path d="m8.5 6.5 2-2"/><path d="m17.5 15.5 2-2"/></svg>
            {%- when 'box' -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>
          {%- endcase -%}
        </div>
        <h3 class="feature-card__title">{{ block.settings.title }}</h3>
        <p class="feature-card__description">{{ block.settings.description }}</p>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product features",
  "settings": [
    { "type": "text", "id": "title", "label": "Titel", "default": "Wat zit er in het bouwplan?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitel", "default": "Alles wat je nodig hebt om direct aan de slag te gaan" }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icoon", "options": [
          { "value": "file-text", "label": "Document" },
          { "value": "package", "label": "Pakket" },
          { "value": "ruler", "label": "Liniaal" },
          { "value": "box", "label": "Box" }
        ], "default": "file-text" },
        { "type": "text", "id": "title", "label": "Titel", "default": "Feature" },
        { "type": "textarea", "id": "description", "label": "Beschrijving", "default": "Beschrijving" }
      ]
    }
  ],
  "presets": [{
    "name": "Product features",
    "blocks": [
      { "type": "feature", "settings": { "icon": "file-text", "title": "Complete zaaglijst", "description": "Exacte maten voor al het hout, klaar om mee te nemen naar de bouwmarkt" } },
      { "type": "feature", "settings": { "icon": "package", "title": "Materiaallijst", "description": "Alle benodigde materialen met artikelnummers voor Gamma, Praxis & Hornbach" } },
      { "type": "feature", "settings": { "icon": "ruler", "title": "Stap-voor-stap instructies", "description": "Duidelijke foto's en uitleg bij elke stap van het bouwproces" } },
      { "type": "feature", "settings": { "icon": "box", "title": "Meerdere configuraties", "description": "Van 2x2 tot 4x4 kratten - kies wat past in jouw ruimte" } }
    ]
  }]
}
{% endschema %}
