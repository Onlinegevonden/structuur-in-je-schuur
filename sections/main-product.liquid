<section class="product-page">
  <div class="container">
    <a href="/" class="breadcrumb">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
      <span>Terug naar home</span>
    </a>

    <div class="product-grid">
      <div class="product__image-wrapper">
        {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}" class="product__image">
        {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product__image' }}
        {%- endif -%}
        <div class="product__price-badge">{{ product.price | money }}</div>
      </div>

      <div class="product__info">
        <span class="badge product__type">{{ section.settings.product_type }}</span>
        <h1 class="product__title">{{ product.title }}</h1>
        
        <div class="product__rating">
          <div class="product__stars">
            {%- for i in (1..5) -%}
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="{% if i <= section.settings.rating %}currentColor{% else %}none{% endif %}" stroke="currentColor" stroke-width="2" class="product__star {% if i <= section.settings.rating %}product__star--filled{% else %}product__star--empty{% endif %}"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            {%- endfor -%}
          </div>
          <span class="product__rating-text">{{ section.settings.rating }}.0 ({{ section.settings.review_count }} reviews)</span>
        </div>

        <p class="product__description">{{ product.description }}</p>

        <div class="product__includes">
          <h3 class="product__includes-title">{{ section.settings.includes_title }}</h3>
          <ul class="product__includes-list">
            {%- for block in section.blocks -%}
              {%- if block.type == 'include' -%}
              <li class="product__includes-item">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                <span>{{ block.settings.text }}</span>
              </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>

        <div class="product__buy">
          {%- form 'product', product -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="btn btn-brand btn-lg" {% unless product.available %}disabled{% endunless %}>
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
            {% if product.available %}Koop nu voor {{ product.price | money }}{% else %}Uitverkocht{% endif %}
          </button>
          {%- endform -%}
        </div>

        <p style="font-size: 0.875rem; color: var(--muted-foreground);">✓ Direct downloaden • ✓ 100% geld-terug-garantie</p>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product informatie",
  "settings": [
    { "type": "text", "id": "product_type", "label": "Product type badge", "default": "Bouwplan" },
    { "type": "range", "id": "rating", "min": 1, "max": 5, "step": 1, "label": "Rating", "default": 5 },
    { "type": "number", "id": "review_count", "label": "Aantal reviews", "default": 24 },
    { "type": "text", "id": "includes_title", "label": "Titel inclusief sectie", "default": "Dit krijg je:" }
  ],
  "blocks": [
    {
      "type": "include",
      "name": "Inclusief item",
      "settings": [
        { "type": "text", "id": "text", "label": "Tekst", "default": "Item" }
      ]
    }
  ],
  "presets": [{
    "name": "Product informatie",
    "blocks": [
      { "type": "include", "settings": { "text": "Complete zaaglijst & materiaallijst (PDF)" } },
      { "type": "include", "settings": { "text": "Stap-voor-stap instructies met foto's" } },
      { "type": "include", "settings": { "text": "5 configuraties (2x2 tot 4x4)" } },
      { "type": "include", "settings": { "text": "Levenslange updates" } }
    ]
  }]
}
{% endschema %}
