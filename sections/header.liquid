<header class="header">
  <div class="container">
    <div class="header__inner">
      <a href="/" class="header__logo">
        <div class="header__logo-icon">{{ section.settings.logo_letter }}</div>
        <span class="header__logo-text">{{ section.settings.logo_text }}</span>
      </a>

      <nav class="header__nav">
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_item' -%}
            <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </nav>

      <div class="header__actions">
        <a href="/cart" class="btn btn-ghost btn-icon header__cart">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"/><circle cx="19" cy="21" r="1"/><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"/></svg>
          <span class="header__cart-count">{{ cart.item_count }}</span>
        </a>
        <a href="{{ section.settings.cta_url }}" class="btn btn-brand header__cta-desktop">{{ section.settings.cta_text }}</a>
        <button class="btn btn-ghost btn-icon header__menu-toggle" data-menu-toggle>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
      </div>
    </div>

    <div class="mobile-menu hidden" data-mobile-menu>
      <nav>
        {%- for block in section.blocks -%}
          {%- if block.type == 'nav_item' -%}
            <a href="{{ block.settings.url }}">{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
        <a href="{{ section.settings.cta_url }}" class="btn btn-brand" style="margin-top: 0.5rem;">{{ section.settings.cta_text }}</a>
      </nav>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "text",
      "id": "logo_letter",
      "label": "Logo letter",
      "default": "S"
    },
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo tekst",
      "default": "Structuur in je Schuur"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA knop tekst",
      "default": "Bekijk bouwplannen"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA knop link",
      "default": "/collections/all"
    }
  ],
  "blocks": [
    {
      "type": "nav_item",
      "name": "Menu item",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Link"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [{
    "name": "Header",
    "blocks": [
      { "type": "nav_item", "settings": { "label": "Bouwplannen", "url": "/collections/all" } },
      { "type": "nav_item", "settings": { "label": "FAQ", "url": "/pages/faq" } },
      { "type": "nav_item", "settings": { "label": "Over mij", "url": "/pages/over-mij" } },
      { "type": "nav_item", "settings": { "label": "Contact", "url": "/pages/contact" } }
    ]
  }]
}
{% endschema %}
