<section class="section section--muted">
  <div class="container">
    <div class="section__header">
      {%- if section.settings.badge != blank -%}
      <p class="section__badge">{{ section.settings.badge }}</p>
      {%- endif -%}
      <h2 class="section__title">{{ section.settings.title }}</h2>
      {%- if section.settings.subtitle != blank -%}
      <p class="section__subtitle">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
      <div class="testimonial" {{ block.shopify_attributes }}>
        <p class="testimonial__quote">"{{ block.settings.quote }}"</p>
        <div class="testimonial__author">
          <div class="testimonial__avatar">{{ block.settings.name | slice: 0 }}</div>
          <div>
            <p class="testimonial__name">{{ block.settings.name }}</p>
            <p class="testimonial__location">{{ block.settings.location }}</p>
          </div>
        </div>
      </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "badge",
      "label": "Badge",
      "default": "Klanten aan het woord"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Titel",
      "default": "Wat anderen zeggen"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitel",
      "default": "Honderden Nederlanders gingen je voor. Dit is wat ze ervan vonden."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Eindelijk een bouwplan dat echt werkt!"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Naam",
          "default": "Peter van Dijk"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Locatie",
          "default": "Almere"
        }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonials",
    "blocks": [
      { "type": "testimonial", "settings": { "quote": "Eindelijk een bouwplan dat echt werkt! Zaterdagochtend begonnen, zondagmiddag stond ie. Mijn vrouw was verbaasd dat ik het gefikst had.", "name": "Peter van Dijk", "location": "Almere" } },
      { "type": "testimonial", "settings": { "quote": "De materiaallijst was perfect. Alles in één keer bij de Gamma gehaald. Geen gedoe met omrekenen of zoeken naar alternatieven.", "name": "Sandra Bakker", "location": "Rotterdam" } },
      { "type": "testimonial", "settings": { "quote": "Nooit eerder iets gebouwd, maar met deze instructies lukte het prima. De stap-voor-stap uitleg is echt idiot-proof.", "name": "Mark Jansen", "location": "Utrecht" } }
    ]
  }]
}
{% endschema %}
